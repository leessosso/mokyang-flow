generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  PASTOR
  LEADER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(LEADER)
  createdAt    DateTime @default(now())

  ledGroups       Group[]           @relation("CurrentLeader")
  leaderTerms     GroupLeaderTerm[]
  pastoralMessages PastoralMessage[]
}

model Group {
  id              String   @id @default(cuid())
  name            String
  description     String?
  currentLeaderId String?
  currentLeader   User?    @relation("CurrentLeader", fields: [currentLeaderId], references: [id])
  members         Member[]
  leaderTerms     GroupLeaderTerm[]
  seatingAssignments SeatingAssignment[]
}

model Member {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  pastoralThread PastoralThread?
  sharingAssignments SharingAssignment[]
  createdAt DateTime @default(now())
}

model GroupLeaderTerm {
  id        String    @id @default(cuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  leaderId  String
  leader    User      @relation(fields: [leaderId], references: [id])
  startedAt DateTime
  endedAt   DateTime?

  @@index([groupId])
}

model LeaderMeeting {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  notes     String?
  sharingPlan SharingPlan?
  createdAt DateTime @default(now())
}

model SharingPlan {
  id            String   @id @default(cuid())
  meetingId     String?  @unique
  meeting       LeaderMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  serviceDate   DateTime
  useHomeGroups Boolean  @default(false)
  tempGroups    SharingGroup[]
}

model SharingGroup {
  id          String   @id @default(cuid())
  planId      String
  plan        SharingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name        String
  homeGroupId String?
  assignments SharingAssignment[]
}

model SharingAssignment {
  id             String       @id @default(cuid())
  sharingGroupId String
  sharingGroup   SharingGroup @relation(fields: [sharingGroupId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sharingGroupId, memberId])
}

model WorshipService {
  id          String   @id @default(cuid())
  date        DateTime
  title       String   @default("주일예배")
  zones       SeatingZone[]
  assignments SeatingAssignment[]
}

model SeatingZone {
  id          String   @id @default(cuid())
  serviceId   String
  service     WorshipService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  sortOrder   Int      @default(0)
  gridRow     Int?
  gridCol     Int?
  assignments SeatingAssignment[]
}

model SeatingAssignment {
  id        String         @id @default(cuid())
  serviceId String
  service   WorshipService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  zoneId    String
  zone      SeatingZone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([serviceId, groupId])
}

model PastoralThread {
  id        String   @id @default(cuid())
  memberId  String   @unique
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  messages  PastoralMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PastoralMessage {
  id        String         @id @default(cuid())
  threadId  String
  thread    PastoralThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime       @default(now())

  @@index([threadId])
}
